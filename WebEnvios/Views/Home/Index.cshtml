@using Entities;
@model E_Envio;

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    @if (TempData["Error"] != null)
    {
        @TempData["Error"]
    }
    <form asp-controller="Home" asp-action="Procesar" method="post">
        <label>Nombre del Destinatario</label>
        <input type="text" name="nombre" />
        <label>Peso</label>
        <input type="number" name="peso" />
        <label>Tipo de Servicio de Envio</label>
        <select name="tipo">
            <option value="estandar">Estándar</option>
            <option value="express">Express</option>
            <option value="mismodia">Mismo Día</option>
        </select>
        <button type="submit">Aceptar</button>
    </form>

    @if (Model != null)
    {
        <p>
            Destinatario: @Model.NombreDestinatario
            Peso:@Model.Peso
            Servicio:@Model.ObtenerEnvio()
            Costo:@Model.CostoEnvio()
            Días:@Model.EntregaDias
        </p>
    }
</body>
</html>